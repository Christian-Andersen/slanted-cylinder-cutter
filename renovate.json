{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Nix flake input updates into a single PR",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs"
    },
    {
      "description": "Group non-major CI action updates in .forgejo/workflows; major bumps get their own PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "groupName": "CI workflow actions",
      "groupSlug": "ci-workflow-actions"
    },
    {
      "description": "Group version-pinned npx CLI tools into a single PR",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["npm"],
      "groupName": "npx CLI tools",
      "groupSlug": "npx-cli-tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track version-pinned npx CLI tools in prek.toml hook entries",
      "managerFilePatterns": ["/(^|/)prek\\.toml$/"],
      "matchStrings": [
        "npx(?: --yes| -y)? (?<depName>@?[a-zA-Z][\\w.-]*?)(?:@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?))"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
