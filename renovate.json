{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:weekly"]
  },
  "packageRules": [
    {
      "description": "Group all Nix flake input updates into one PR, aligned with the weekly flake.lock refresh",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs",
      "extends": ["schedule:weekly"]
    }
  ],
  "customManagers": [
    {
      "description": "Track npm packages pinned via npx in prek.toml hook entries",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)prek\\.toml$/"],
      "matchStrings": [
        "npx(?: --yes)? (?<depName>[a-z0-9][a-z0-9-]*)@(?<currentValue>v?\\d+(?:\\.\\d+)*)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}